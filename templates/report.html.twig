<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>php-doctor — {{ project.name }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen">

<!-- Header -->
<header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-6 flex items-center gap-8">
        <!-- Score Circle SVG -->
        <div class="flex-shrink-0">
            {% set circumference = 2 * 3.14159 * 40 %}
            {% set dashOffset = circumference * (1 - score.global / 100) %}
            {% if score.global >= 80 %}
                {% set strokeColor = '#22c55e' %}
                {% set textColor = 'text-green-600' %}
            {% elseif score.global >= 60 %}
                {% set strokeColor = '#eab308' %}
                {% set textColor = 'text-yellow-600' %}
            {% else %}
                {% set strokeColor = '#ef4444' %}
                {% set textColor = 'text-red-600' %}
            {% endif %}
            <svg width="100" height="100" viewBox="0 0 100 100" class="rotate-[-90deg]">
                <circle cx="50" cy="50" r="40" fill="none" stroke="#e5e7eb" stroke-width="10"/>
                <circle cx="50" cy="50" r="40" fill="none"
                        stroke="{{ strokeColor }}"
                        stroke-width="10"
                        stroke-dasharray="{{ circumference }}"
                        stroke-dashoffset="{{ dashOffset }}"
                        stroke-linecap="round"/>
            </svg>
            <div class="absolute" style="margin-top:-68px;margin-left:28px;">
                <span class="text-xl font-bold {{ textColor }} rotate-90 inline-block" style="transform:rotate(90deg)">{{ score.global }}</span>
            </div>
        </div>

        <div>
            <h1 class="text-2xl font-bold text-gray-900">{{ project.name }}</h1>
            <p class="text-gray-500 mt-1">
                Framework: <span class="font-medium text-gray-700">{{ project.framework|capitalize }}</span>
                &nbsp;·&nbsp;
                Path: <code class="text-sm bg-gray-100 px-1 rounded">{{ project.rootPath }}</code>
            </p>
            <p class="mt-2">
                Global score:
                <span class="font-bold text-lg
                    {% if score.global >= 80 %}text-green-600
                    {% elseif score.global >= 60 %}text-yellow-600
                    {% else %}text-red-600{% endif %}">
                    {{ score.global }}/100
                </span>
            </p>
        </div>
    </div>
</header>

<!-- Main content -->
<main class="max-w-6xl mx-auto px-6 py-8">

    <!-- Search bar -->
    <div class="mb-6">
        <input
            type="search"
            id="findings-search"
            placeholder="Filter findings by rule, message, or file…"
            class="w-full max-w-lg px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <span id="search-count" class="ml-3 text-sm text-gray-500"></span>
    </div>

    <!-- Category Score Cards -->
    <section class="mb-10">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Scores by Category</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {% for category, catScore in score.byCategory %}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-2">{{ category }}</div>
                <div class="text-3xl font-bold
                    {% if catScore >= 80 %}text-green-600
                    {% elseif catScore >= 60 %}text-yellow-600
                    {% else %}text-red-600{% endif %}">
                    {{ catScore }}
                </div>
                <div class="text-xs text-gray-400 mt-1">/100</div>
            </div>
            {% endfor %}
        </div>
    </section>

    <!-- Findings by Category -->
    <section>
        <h2 class="text-lg font-semibold text-gray-700 mb-4">
            Findings
            <span class="text-gray-400 font-normal text-base">({{ summary.totalFindings }} total)</span>
        </h2>

        {% if summary.totalFindings == 0 %}
        <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center text-green-700 font-medium">
            No findings — clean run!
        </div>
        {% else %}

        {% for category, categoryFindings in findingsByCategory %}
        <details class="mb-4 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden" open>
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer select-none hover:bg-gray-50">
                <span class="font-semibold text-gray-800 capitalize">{{ category }}</span>
                <span class="bg-gray-100 text-gray-600 text-sm px-2 py-0.5 rounded-full">
                    {{ categoryFindings|length }} finding{{ categoryFindings|length != 1 ? 's' : '' }}
                </span>
            </summary>
            <div class="overflow-x-auto">
                <table class="w-full text-sm" data-category="{{ category }}">
                    <thead class="bg-gray-50 border-t border-gray-200">
                        <tr>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Severity</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Rule</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Location</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Message</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for finding in categoryFindings %}
                        <tr class="finding-row hover:bg-gray-50"
                            data-rule="{{ finding.ruleId }}"
                            data-message="{{ finding.message }}"
                            data-file="{{ finding.file }}">
                            <td class="px-4 py-3">
                                <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold
                                    {% if finding.severity == 'critical' %}bg-red-100 text-red-800
                                    {% elseif finding.severity == 'high' %}bg-orange-100 text-orange-800
                                    {% elseif finding.severity == 'medium' %}bg-yellow-100 text-yellow-800
                                    {% elseif finding.severity == 'low' %}bg-blue-100 text-blue-800
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ finding.severity }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-gray-700 font-mono text-xs">{{ finding.ruleId }}</td>
                            <td class="px-4 py-3">
                                {% if finding.file %}
                                <code class="text-xs bg-gray-100 px-1 rounded">{{ finding.file }}{% if finding.line %}:{{ finding.line }}{% endif %}</code>
                                {% else %}
                                <span class="text-gray-400">—</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-gray-700">
                                {{ finding.message }}
                                {% if finding.fixHint %}
                                <br><em class="text-xs text-gray-500">{{ finding.fixHint }}</em>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </details>
        {% endfor %}

        <!-- Summary table -->
        <div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-600 mb-3 uppercase tracking-wide">By Severity</h3>
            <div class="flex flex-wrap gap-4">
                {% for sev, count in summary.bySeverity %}
                {% if count > 0 %}
                <div class="text-center">
                    <div class="text-2xl font-bold
                        {% if sev == 'critical' %}text-red-600
                        {% elseif sev == 'high' %}text-orange-600
                        {% elseif sev == 'medium' %}text-yellow-600
                        {% elseif sev == 'low' %}text-blue-600
                        {% else %}text-gray-500{% endif %}">{{ count }}</div>
                    <div class="text-xs text-gray-500 capitalize">{{ sev }}</div>
                </div>
                {% endif %}
                {% endfor %}
            </div>
        </div>

        {% endif %}
    </section>
</main>

<!-- Footer -->
<footer class="border-t border-gray-200 bg-white mt-10 py-4 text-center text-xs text-gray-400">
    Generated at {{ generatedAt }} by <strong>php-doctor v0.1.0-dev</strong>
</footer>

<!-- Embedded data for client-side use -->
<script type="application/json" id="phpdoctor-data">{{ jsonData|raw }}</script>

<!-- Inline JS: live search filter (~30 lines) -->
<script>
(function () {
    var input   = document.getElementById('findings-search');
    var counter = document.getElementById('search-count');
    var rows    = document.querySelectorAll('tr.finding-row');

    function updateCount() {
        var visible = document.querySelectorAll('tr.finding-row:not([hidden])').length;
        counter.textContent = visible === rows.length ? '' : visible + ' of ' + rows.length + ' shown';
    }

    input.addEventListener('input', function () {
        var query = this.value.toLowerCase().trim();
        rows.forEach(function (row) {
            if (!query) {
                row.removeAttribute('hidden');
            } else {
                var text = [
                    row.dataset.rule || '',
                    row.dataset.message || '',
                    row.dataset.file || ''
                ].join(' ').toLowerCase();
                if (text.includes(query)) {
                    row.removeAttribute('hidden');
                } else {
                    row.setAttribute('hidden', '');
                }
            }
        });
        updateCount();
    });
})();
</script>

</body>
</html>
